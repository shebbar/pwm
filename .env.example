# Copy to .env (gitignored) and fill in. `docker compose` reads this
# automatically; see README.md for the full explanation of each variable.

# Postgres connection string. The default below matches the `postgres`
# superuser on a fresh Postgres container -- override if your `pgdb`
# container uses different credentials.
DATABASE_URL=postgresql://postgres:postgres@pgdb:5432/pwm

# Claude Platform API key for the chat agent. Deliberately NOT named
# ANTHROPIC_API_KEY -- that name is read by Claude Code itself and would
# bill usage against the wrong account.
PORTFOLIO_LLM_API_KEY=

# Shared secret between mcp-server.ts and any MCP client (the in-app agent,
# Claude Desktop, etc.). Required -- the MCP server refuses to start without
# it. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional -- caps the agent's tool-calling loop (default 6).
# AGENT_MAX_ITERATIONS=6

# Optional -- port the MCP server listens on (default 4100).
# MCP_PORT=4100

# Optional -- where agent.ts reaches the MCP server as a client (default
# http://mcp:4100/mcp, the Docker service name -- only override if running
# the agent outside Docker, e.g. http://localhost:4100/mcp).
# MCP_SERVER_URL=http://mcp:4100/mcp
